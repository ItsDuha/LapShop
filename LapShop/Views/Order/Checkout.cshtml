@model VmCheckout

<!-- breadcrumb start -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>checkout</h2>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item active">checkout</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb End -->
<!-- section start -->
<section class="section-b-space">
    <div class="container">
        <div class="checkout-page">
            <div class="checkout-form">

                <form asp-controller="Order" asp-action="OrderSuccess" method="post">

                    <div class="row">

                        <!-- Billing Details -->
                        <div class="col-lg-6 col-sm-12 col-xs-12">

                            <div class="checkout-title">
                                <h3>Billing Details</h3>
                            </div>

                            <div class="row check-out">

                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <div class="field-label">First Name</div>

                                    <input asp-for="FirstName"
                                           class="form-control"
                                           readonly />

                                    <span asp-validation-for="FirstName"
                                          class="text-danger"></span>
                                </div>


                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <div class="field-label">Last Name</div>

                                    <input asp-for="LastName"
                                           class="form-control"
                                           readonly />

                                    <span asp-validation-for="LastName"
                                          class="text-danger"></span>
                                </div>


                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <div class="field-label">Phone</div>

                                    <input asp-for="Phone"
                                           class="form-control" />

                                    <span asp-validation-for="Phone"
                                          class="text-danger"></span>
                                </div>


                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <div class="field-label">Email Address</div>

                                    <input asp-for="Email"
                                           class="form-control"
                                           readonly />

                                    <span asp-validation-for="Email"
                                          class="text-danger"></span>
                                </div>


                                <div class="form-group col-md-12 col-sm-12 col-xs-12">
                                    <div class="field-label">Address</div>

                                    <input asp-for="Address"
                                           class="form-control"
                                           placeholder="Street Address" />

                                    <span asp-validation-for="Address"
                                          class="text-danger"></span>
                                </div>


                                <div class="form-group col-md-12 col-sm-12 col-xs-12">
                                    <div class="field-label">Notes</div>

                                    <textarea asp-for="Notes"
                                              rows="4"
                                              class="form-control"
                                              placeholder="Any delivery notes?"></textarea>
                                </div>

                            </div>

                        </div>


                        <!-- Order Details -->
                        <div class="col-lg-6 col-sm-12 col-xs-12">

                            <div class="checkout-details">

                                <div class="order-box">

                                    <div class="title-box">
                                        <div>
                                            Product
                                            <span>Total</span>
                                        </div>
                                    </div>

                                    <ul class="qty">

                                        @foreach (var item in Model.Cart.lstItems)
                                        {
                                            <li>
                                                @item.ItemName × @item.Qty
                                                <span>$@item.Total</span>
                                            </li>
                                        }

                                    </ul>

                                    <ul class="sub-total">

                                        <li>
                                            Subtotal
                                            <span class="count">
                                                $@Model.Cart.Total
                                            </span>
                                        </li>

                                    </ul>

                                    <ul class="total">

                                        <li>
                                            Total
                                            <span class="count">
                                                $@Model.Cart.Total
                                            </span>
                                        </li>

                                    </ul>

                                </div>


                                <div class="payment-box">

                                    <div class="upper-box">

                                        <div class="payment-options">

                                            <ul>

                                                <li>

                                                    <div class="radio-option">

                                                        <input type="radio"
                                                               name="payment-group"
                                                               id="payment-2"
                                                               checked="checked" />

                                                        <label for="payment-2">
                                                            Cash On Delivery
                                                            <span class="small-text">
                                                                Pay when your order is delivered.
                                                            </span>
                                                        </label>

                                                    </div>

                                                </li>

                                            </ul>

                                        </div>

                                    </div>

                                    <div class="text-right">

                                        <button type="submit"
                                                class="btn btn-solid">
                                            Place Order
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </form>

            </div>
        </div>
    </div>
</section>
<!-- section end -->


<style>

    input[readonly] {
        background: #f8f8f8;
        cursor: not-allowed;
    }

</style>