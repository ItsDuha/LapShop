@model VmCheckout

<!-- breadcrumb start -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>Order Success</h2>
                </div>
            </div>

            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="breadcrumb-item active">
                            Order Success
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- breadcrumb End -->


<section class="section-b-space">

    <div class="container">

        <!-- Success Message -->

        <div class="row">

            <div class="col-lg-8 offset-lg-2">

                <div class="checkout-details">

                    <div class="order-box text-center p-5">

                        <i class="fa fa-check-circle"
                           style="font-size:70px;color:#28a745;"></i>

                        <h2 class="mt-4">
                            Thank You!
                        </h2>

                        <h4>
                            @Model.FirstName @Model.LastName
                        </h4>

                        <p>
                            Your order has been placed successfully.
                        </p>

                        <hr />

                        <h5>
                            Payment Method
                        </h5>

                        <strong>
                            Cash On Delivery
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- Order Summary -->

        <div class="row mt-5">

            <div class="col-lg-8 offset-lg-2">

                <div class="checkout-details">

                    <div class="order-box">

                        <div class="title-box">

                            <div>

                                Product

                                <span>Total</span>

                            </div>

                        </div>

                        <ul class="qty">

                            @foreach (var item in Model.Cart.lstItems)
                            {
                                <li>

                                    @item.ItemName × @item.Qty

                                    <span>

                                        $@item.Total

                                    </span>

                                </li>
                            }

                        </ul>

                        <ul class="sub-total">

                            <li>

                                Subtotal

                                <span class="count">

                                    $@Model.Cart.Total

                                </span>

                            </li>

                        </ul>

                        <ul class="total">

                            <li>

                                Total

                                <span class="count">

                                    $@Model.Cart.Total

                                </span>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>


        <!-- Delivery Information -->

        <div class="row mt-5">

            <div class="col-lg-8 offset-lg-2">

                <div class="checkout-details">

                    <div class="order-box">

                        <div class="title-box">

                            <div>

                                Delivery Information

                            </div>

                        </div>

                        <ul class="qty">

                            <li>

                                Phone

                                <span>

                                    @Model.Phone

                                </span>

                            </li>

                            <li>

                                Address

                                <span>

                                    @Model.Address

                                </span>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>


        <!-- Buttons -->

        <div class="row mt-5">

            <div class="col-lg-12 text-center">

                <a asp-controller="Items"
                   asp-action="ItemList"
                   class="btn btn-solid">
                    Continue Shopping
                </a>

                <a asp-controller="Order"
                   asp-action="MyOrders"
                   class="btn btn-solid">
                    My Orders
                </a>

            </div>

        </div>

    </div>

</section>